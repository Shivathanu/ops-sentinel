# Ops Sentinel engine settings. Copy to .env next to your sentinel.yaml and fill in the blanks.
# Run engine/scripts/bootstrap_sentinel_roles.py --env-file .env to create the Exasol users and write their passwords.
# Never commit the filled-in file.

# --- Workspace specs ---
# A sentinel.yaml, or a directory with one spec per team.
OPS_SENTINEL_SPEC_FILE=/app/config/sentinel.yaml

# --- API security (fails closed) ---
# Required for the API and for ingest sources without their own token:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
OPS_SENTINEL_API_KEY=
# true only on a trusted local machine; never in a shared environment.
OPS_SENTINEL_API_AUTH_DISABLED=false

# --- Exasol ---
EXASOL_ADMIN_HOST=host.docker.internal      # an Exasol on this machine, as seen from a container
EXASOL_ADMIN_PORT=8563
EXASOL_VALIDATE_CERTIFICATE=true            # false only for a local self-signed instance
# Platform schema: incidents, jobs, agent runs, audit, UDFs.
OPS_SENTINEL_PLATFORM_SCHEMA=OPS_SENTINEL
# Schema holding the pipeline and business tables the agents investigate.
EXASOL_SCHEMA=SENTINEL

# Runtime user (api and worker): DML on platform tables, append-only audit log.
EXASOL_ADMIN_USER=sentinel_engine
EXASOL_ADMIN_PASSWORD=
# Schema owner: migrations and UDF installs only. Leave empty on a laptop to migrate as the runtime user.
EXASOL_MIGRATOR_USER=
EXASOL_MIGRATOR_PASSWORD=
# Runs approved, guardrail-checked SQL fixes on named business tables only.
EXASOL_EXECUTOR_USER=sentinel_executor
EXASOL_EXECUTOR_PASSWORD=
# Read-only login for the agents' Exasol toolset.
EXA_USER=mcp_readonly
EXA_PASSWORD=

# --- Slack approvals ---
# Verifies Slack's interactivity callbacks; only these Slack user ids may approve or reject. Empty means nobody.
SLACK_SIGNING_SECRET=
SLACK_APPROVER_IDS=

# --- Secrets referenced by sentinel.yaml (add one line per ${env:NAME} your specs use) ---
ANTHROPIC_API_KEY=
SLACK_BOT_TOKEN=
AM_INGEST_TOKEN=

# --- Engine tuning ---
# The api applies migrations on start; set false where a separate migration step runs (Kubernetes Job).
OPS_SENTINEL_AUTO_MIGRATE=true
OPS_SENTINEL_WORKER_CONCURRENCY=4
OPS_SENTINEL_WORKER_LEASE_SECONDS=300
# Optional: a business-context file the agents read (for example /app/context/business-context.md, mounted in).
BUSINESS_CONTEXT_FILE=
