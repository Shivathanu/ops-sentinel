# --- LLM provider (pick one) ---
LLM_PROVIDER=openai                 # openai | anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=C0123456789

# --- Exasol: MCP (read-only investigation path) ---
# This launches the real `exasol-mcp-server` package via `uvx`, the exact
# same way `exakit mcp-setup` configures it for Claude/Codex/Cursor. Run
# `exakit info` for the DSN and `exakit mcp-status` for the per-client
# config exakit already wrote, to confirm these match on your machine.
EXASOL_MCP_COMMAND=uvx
EXASOL_MCP_ARGS=exasol-mcp-server@1.10.1
EXA_DSN=127.0.0.1:8563
EXA_USER=mcp_readonly
EXA_PASSWORD=                      # exakit info -> "stored in ~/.exasol-starter-kit/credentials/mcp_readonly_password"
EXA_MCP_SETTINGS={"enable_read_query": true, "enable_summarize_table": true, "enable_query_profiling": true, "enable_write_query": false, "enable_write_bucketfs": false}
EXA_SSL_CERT_VALIDATION=no           # "yes" in any shared environment

# --- Exasol: engine connection (incident bookkeeping and audit rows) ---
# Use the limited `sentinel_engine` user from sql/roles.sql, never SYS.
EXASOL_ADMIN_HOST=127.0.0.1
EXASOL_ADMIN_PORT=8563
EXASOL_ADMIN_USER=sentinel_engine
EXASOL_ADMIN_PASSWORD=
EXASOL_SCHEMA=SENTINEL
EXASOL_POOL_SIZE=5
EXASOL_VALIDATE_CERTIFICATE=true    # false only for a local self-signed instance

# --- Exasol: executor connection (approved remediation SQL only) ---
# `sentinel_executor` from sql/roles.sql: DML on business tables, nothing on Sentinel's own tables.
EXASOL_EXECUTOR_USER=sentinel_executor
EXASOL_EXECUTOR_PASSWORD=

# --- API and approval security (all fail closed) ---
# Required by /api/* and the dashboard; generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
OPS_SENTINEL_API_KEY=
# Set true only on a trusted local machine to run without a key.
OPS_SENTINEL_API_AUTH_DISABLED=false
# Comma-separated Slack user IDs allowed to click Approve or Reject. Empty means nobody can.
SLACK_APPROVER_IDS=

# --- Watcher tuning ---
WATCH_INTERVAL_SECONDS=10
COST_SPIKE_THRESHOLD_USD=5.00
TRUST_SCORE_WINDOW_HOURS=24

# --- Engine ---
ENGINE_BASE_URL=http://localhost:8000

# --- Platform (v2): workspace specs, migrations, worker ---
# A sentinel.yaml, or a directory with one spec per team. Unset = v1 endpoints only.
OPS_SENTINEL_SPEC_FILE=
# Platform tables, UDFs and the job queue live here, separate from the v1 SENTINEL schema.
OPS_SENTINEL_PLATFORM_SCHEMA=OPS_SENTINEL
# Schema owner used only for migrations and UDF installs (engine/scripts/bootstrap_sentinel_roles.py creates it).
# Leave empty on a laptop to migrate as EXASOL_ADMIN_USER.
EXASOL_MIGRATOR_USER=
EXASOL_MIGRATOR_PASSWORD=
# The api applies migrations on start; set false where a separate migration step runs (Helm pre-upgrade Job).
OPS_SENTINEL_AUTO_MIGRATE=true
OPS_SENTINEL_WORKER_CONCURRENCY=4
OPS_SENTINEL_WORKER_LEASE_SECONDS=300
